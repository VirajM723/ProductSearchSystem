# Copy to .env next to docker-compose.prod.yml and fill everything in.
# Generate each password with:  openssl rand -hex 24
# (hex only, so nothing needs escaping in URLs or YAML)

# Your domain, e.g. shop.example.com or myshop.duckdns.org.
# Its DNS A record must point at the server's public IP.
SITE_ADDRESS=

MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# "elastic" superuser, only used once to create the API's own user.
ELASTIC_PASSWORD=
ES_APP_PASSWORD=
# Elasticsearch memory. 1g is plenty for a small catalogue.
ES_HEAP=1g

# Admin login for /manage. Get the hash and secret with:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api node scripts/hash-password.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
SESSION_HOURS=8
