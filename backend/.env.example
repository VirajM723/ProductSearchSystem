PORT=3000
MONGODB_URI=mongodb://localhost:27017/productsearch

ELASTICSEARCH_NODE=http://localhost:9200
ES_INDEX=products
# Only needed when Elasticsearch has security switched on.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_CA_CERT=/path/to/http_ca.crt

# Admin login for the inventory pages. Generate the hash and secret with:
#   npm run hash-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
SESSION_HOURS=8

# Comma separated list of origins allowed to call the API from another
# domain. Leave empty when the frontend is served from the same domain.
CORS_ORIGIN=
